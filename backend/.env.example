# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI API (for AI features)
OPENAI_API_KEY=sk-your-openai-key

# CORS - comma-separated list of allowed origins
# For production, set to your Vercel frontend URL
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Optional: Force storage type (supabase or sqlite)
# STORAGE_TYPE=supabase

# Optional: demo mode - only allow one email to use the API
# DEMO_MODE=true
# DEMO_ALLOWED_EMAIL=mbakayaweever@gmail.com

# Sentry error tracking (set per-service via Google Secret Manager, not here)
# Prod DSN -> parity-backend-prod service secret
# Staging DSN -> parity-backend (staging) service secret
# Leave unset locally to disable Sentry silently.
# SENTRY_DSN=https://...@sentry.io/...

# Sentry debug verification route (staging only, remove after confirming capture)
# SENTRY_DEBUG_ROUTE=true
